# Copy to .env.elder, source it, then use scripts/elder/train_stage1_full_4h20.sh.
# This file contains no credentials and is safe to customize locally.

export ELDER_MODEL_PATH=/root/autodl-tmp/models/Qwen2-VL-2B-Instruct
export ELDER_MMEB_DATA=/root/autodl-tmp/datasets/MMEB-train
export ELDER_LLAVAHOUND_DATA=/root/autodl-tmp/datasets/train_video_and_instruction
export ELDER_COLPALI_DATA=/root/autodl-tmp/datasets/colpali_train_set
export ELDER_VISRAG_DATA=/root/autodl-tmp/datasets/VisRAG-Ret-Train-In-domain-data

export ELDER_OUTPUT_DIR=/root/autodl-tmp/checkpoints/elder/stage1_full
export ELDER_CUDA_VISIBLE_DEVICES=0,1,2,3

# Keep all generated metadata and temporary files on the data disk, not root.
export HF_HOME=/root/autodl-tmp/hf_cache
export HF_DATASETS_CACHE=/root/autodl-tmp/hf_cache/datasets
export TMPDIR=/root/autodl-tmp/tmp

# The full-local configuration does not need network access at training time.
export HF_HUB_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export TRANSFORMERS_OFFLINE=1

export WANDB_MODE=disabled
export TOKENIZERS_PARALLELISM=false

# Set a positive integer if a parent shell exported an invalid OpenMP value.
export OMP_NUM_THREADS=8
